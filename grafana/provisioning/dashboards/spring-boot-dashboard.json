{
  "title": "Spring Boot Application Metrics",
  "description": "Dashboard for monitoring PG Management Spring Boot Application",
  "tags": ["spring-boot", "prometheus"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "uid": "spring-boot-metrics",
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "JVM Memory Used",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "jvm_memory_used_bytes{application=\"pgmanagement\"}",
          "legendFormat": "{{area}} - {{id}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] }
    },
    {
      "id": 2,
      "title": "HTTP Request Rate",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum by (method, uri, status) (rate(http_server_requests_seconds_count{application=\"pgmanagement\"}[5m]))",
          "legendFormat": "{{method}} {{uri}} ({{status}})",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] }
    },
    {
      "id": 3,
      "title": "HTTP Average Response Time",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "sum by (method, uri) (rate(http_server_requests_seconds_sum{application=\"pgmanagement\"}[5m])) / sum by (method, uri) (rate(http_server_requests_seconds_count{application=\"pgmanagement\"}[5m]))",
          "legendFormat": "{{method}} {{uri}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }
    },
    {
      "id": 4,
      "title": "HikariCP Connection Pool",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "hikaricp_connections{application=\"pgmanagement\"}",
          "legendFormat": "{{state}}",
          "refId": "A"
        },
        {
          "expr": "hikaricp_connections_active{application=\"pgmanagement\"}",
          "legendFormat": "active",
          "refId": "B"
        }
      ]
    },
    {
      "id": 5,
      "title": "JVM Threads",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "jvm_threads_live_threads{application=\"pgmanagement\"}",
          "legendFormat": "live",
          "refId": "A"
        },
        {
          "expr": "jvm_threads_daemon_threads{application=\"pgmanagement\"}",
          "legendFormat": "daemon",
          "refId": "B"
        }
      ]
    },
    {
      "id": 6,
      "title": "Process CPU Usage",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        {
          "expr": "process_cpu_usage{application=\"pgmanagement\"}",
          "legendFormat": "cpu",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] }
    }
  ]
}
