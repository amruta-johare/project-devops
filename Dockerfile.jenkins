FROM jenkins/jenkins:lts-jdk21

USER root

# Docker CLI so the pipeline can build images on the host's daemon
RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates curl gnupg jq && \
    install -m 0755 -d /etc/apt/keyrings && \
    curl -fsSL https://download.docker.com/linux/debian/gpg | gpg --dearmor -o /etc/apt/keyrings/docker.gpg && \
    chmod a+r /etc/apt/keyrings/docker.gpg && \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/debian $(. /etc/os-release && echo $VERSION_CODENAME) stable" > /etc/apt/sources.list.d/docker.list && \
    apt-get update && \
    apt-get install -y --no-install-recommends docker-ce-cli docker-compose-plugin && \
    rm -rf /var/lib/apt/lists/*

# Allow jenkins user to use docker socket
RUN groupmod -g 999 docker || true && \
    usermod -aG docker jenkins || true

# Skip the setup wizard – JCasC handles bootstrap
ENV JAVA_OPTS="-Djenkins.install.runSetupWizard=false"
ENV CASC_JENKINS_CONFIG=/var/jenkins_home/casc.yaml

USER jenkins

# Bake plugins
COPY jenkins/plugins.txt /usr/share/jenkins/ref/plugins.txt
RUN jenkins-plugin-cli --plugin-file /usr/share/jenkins/ref/plugins.txt

# JCasC config baked into image (also overlayable via /var/jenkins_home/casc.yaml mount)
COPY jenkins/casc.yaml /usr/share/jenkins/ref/casc.yaml
COPY jenkins/init.groovy.d/ /usr/share/jenkins/ref/init.groovy.d/
